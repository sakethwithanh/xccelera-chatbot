# ---- Google Gemini ----
# Get a key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# ---- Supabase ----
# Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
# service_role key (SERVER ONLY - never expose to frontend)
SUPABASE_SERVICE_KEY=your-service-role-key

# Project Settings -> Database -> Connection string (URI).
# Use the "Session" pooler or direct connection. LangGraph's
# AsyncPostgresSaver connects here for conversation checkpoints.
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.your-project.supabase.co:5432/postgres

# ---- App ----
# Max prior turns fed into the model per request (cost/latency cap).
HISTORY_LIMIT=20
# Comma-separated allowed CORS origins (the frontend URL).
CORS_ORIGINS=http://localhost:5173
